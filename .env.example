# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Authentication ──────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_REFRESH_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cache ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
OTEL_DEBUG=false

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; use * for development only
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Monitoring ──────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_ENABLED=true

# ── Kafka (optional — needed for M8.x event-driven features) ───────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ecotrack-api
KAFKA_GROUP_ID=ecotrack-consumers
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── External Services ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PUSH_FCM_KEY=
